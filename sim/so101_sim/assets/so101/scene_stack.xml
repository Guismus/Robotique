<mujoco model="tek5_stack">
    <include file="so101_tek5.xml" />

    <visual>
        <headlight diffuse="0.6 0.6 0.6" ambient="0.3 0.3 0.3" specular="0 0 0" />
        <global azimuth="160" elevation="-20" offwidth="1280" offheight="720" />
    </visual>

    <default>
        <!-- pickup_object: rendered with the full mesh, collisions with 8 convex pieces (one per
             octant of the cube, see scripts/make_pickup_object_collision.py) that leave the
             diamond tunnels open to the gripper. -->
        <default class="pickup_visual">
            <geom type="mesh" mesh="pickup_object" material="red" contype="0" conaffinity="0"
                group="2" density="0" />
        </default>
        <default class="pickup_collision">
            <geom type="mesh" mesh="pickup_object_collision" group="3" mass="0.005"
                friction="1.0 0.005 0.0001" />
        </default>
    </default>

    <asset>
        <texture type="2d" name="groundplane" builtin="checker" mark="edge"
            rgb1="0.25 0.25 0.28" rgb2="0.18 0.18 0.20" markrgb="0.6 0.6 0.6"
            width="300" height="300" />
        <material name="groundplane" texture="groundplane" texuniform="true"
            texrepeat="5 5" reflectance="0.1" />
        <!-- Hue and saturation of the printed PLA as seen by the real camera (OpenCV HSV ~168, 185) -->
        <material name="red" rgba="0.80 0.05 0.22 1" specular="0.3" shininess="0.3" />
        <material name="box_mat" rgba="0.35 0.20 0.12 1" />
        <!-- Socle plus sombre que le bac : a plat, il recoit plus de lumiere (V doit rester < 180) -->
        <material name="socle_mat" rgba="0.26 0.15 0.09 1" />
        <mesh name="pickup_object" file="hollow_cube_rhombus_50mm.stl" scale="0.001 0.001 0.001" />
        <mesh name="pickup_object_collision" file="pickup_object_collision_octant.stl"
            scale="0.001 0.001 0.001" />
        <!-- Marqueurs ArUco (DICT_4X4_50) pour calibrer la camera, generes par ros2_ws/checks/make_aruco.py -->
        <texture type="2d" name="aruco_0" file="aruco_0.png" />
        <texture type="2d" name="aruco_1" file="aruco_1.png" />
        <texture type="2d" name="aruco_2" file="aruco_2.png" />
        <texture type="2d" name="aruco_3" file="aruco_3.png" />
        <material name="aruco_0" texture="aruco_0" />
        <material name="aruco_1" texture="aruco_1" />
        <material name="aruco_2" texture="aruco_2" />
        <material name="aruco_3" texture="aruco_3" />
    </asset>

    <worldbody>
        <light pos="0 0 2.5" dir="0 0 -1" directional="true" />
        <light pos="0.5 0.5 1.5" dir="-0.3 -0.3 -1" diffuse="0.4 0.4 0.4" />
        <geom name="floor" size="0 0 0.05" pos="0 0 0" type="plane" material="groundplane" />

        <!-- 4 marqueurs ArUco colles sur la table, aux coins de la vue camera, hors de portee du bras.
             Plaque de 13,3 cm (carre noir de 10 cm + bord blanc), sans collision.
             Les positions doivent rester identiques a MARKERS dans perception_node.py. -->
        <geom name="aruco_0" type="box" size="0.0667 0.0667 0.0005" pos="0.48 -0.27 0.0005" material="aruco_0" contype="0" conaffinity="0" />
        <geom name="aruco_1" type="box" size="0.0667 0.0667 0.0005" pos="0.48 0.27 0.0005" material="aruco_1" contype="0" conaffinity="0" />
        <geom name="aruco_2" type="box" size="0.0667 0.0667 0.0005" pos="-0.28 0.27 0.0005" material="aruco_2" contype="0" conaffinity="0" />
        <geom name="aruco_3" type="box" size="0.0667 0.0667 0.0005" pos="-0.28 -0.27 0.0005" material="aruco_3" contype="0" conaffinity="0" />

        <!-- Pile : 3 cubes rouges identiques au cube de la phase 1, places au hasard par
             SO101Sim.randomize_object(). Le bras les empile sur le socle. -->
        <body name="pickup_object" pos="0.25 0.05 0.025">
            <freejoint name="pickup_object_free" />
            <geom name="pickup_object_visual" class="pickup_visual" pos="0 0 -0.025" />
            <geom class="pickup_collision" quat="1 0 0 0" />
            <geom class="pickup_collision" quat="0.70711 0 0 0.70711" />
            <geom class="pickup_collision" quat="0 0 0 1" />
            <geom class="pickup_collision" quat="0.70711 0 0 -0.70711" />
            <geom class="pickup_collision" quat="0 1 0 0" />
            <geom class="pickup_collision" quat="0 0.70711 0.70711 0" />
            <geom class="pickup_collision" quat="0 0 1 0" />
            <geom class="pickup_collision" quat="0 0.70711 -0.70711 0" />
        </body>

        <body name="cube_2" pos="0.25 0.15 0.025">
            <freejoint name="cube_2_free" />
            <geom name="cube_2_visual" class="pickup_visual" pos="0 0 -0.025" />
            <geom class="pickup_collision" quat="1 0 0 0" />
            <geom class="pickup_collision" quat="0.70711 0 0 0.70711" />
            <geom class="pickup_collision" quat="0 0 0 1" />
            <geom class="pickup_collision" quat="0.70711 0 0 -0.70711" />
            <geom class="pickup_collision" quat="0 1 0 0" />
            <geom class="pickup_collision" quat="0 0.70711 0.70711 0" />
            <geom class="pickup_collision" quat="0 0 1 0" />
            <geom class="pickup_collision" quat="0 0.70711 -0.70711 0" />
        </body>

        <body name="cube_3" pos="0.2 0.25 0.025">
            <freejoint name="cube_3_free" />
            <geom name="cube_3_visual" class="pickup_visual" pos="0 0 -0.025" />
            <geom class="pickup_collision" quat="1 0 0 0" />
            <geom class="pickup_collision" quat="0.70711 0 0 0.70711" />
            <geom class="pickup_collision" quat="0 0 0 1" />
            <geom class="pickup_collision" quat="0.70711 0 0 -0.70711" />
            <geom class="pickup_collision" quat="0 1 0 0" />
            <geom class="pickup_collision" quat="0 0.70711 0.70711 0" />
            <geom class="pickup_collision" quat="0 0 1 0" />
            <geom class="pickup_collision" quat="0 0.70711 -0.70711 0" />
        </body>

        <!-- Socle de la pile : plaque marron de 10 cm (meme couleur que le bac, donc vue par la
             perception comme drop_box). Sur le vrai bras : une feuille marron/orange posee sur la table. -->
        <body name="drop_box" pos="0.12 -0.20 0.0">
            <geom type="box" size="0.05 0.05 0.001" pos="0 0 0.001" material="socle_mat" />
        </body>

        <!-- Fixed external camera (eye-to-hand), KNOWN pose: this is the reference
             camera->world TF. Looks at the workspace from above/the side. -->
        <camera name="external_cam" pos="0.10 0 0.75" xyaxes="1 0 0 0 1 0"
            fovy="52" />
    </worldbody>
</mujoco>
